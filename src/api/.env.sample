API_PORT=3000
FRONTEND_URL=http://localhost:8080
AUTH_REDIRECT=http://localhost:8080/login-complete

VIVVO_CLIENT_ID=CLIENT
VIVVO_CLIENT_SECRET=SECRET
VIVVO_CALLBACK_URL=http://host:port/path

BASE_URL=http://localhost:3000

# --- Auth: the API validates Auth0-issued RS256 access tokens (Bearer) ---
# ISSUER_BASE_URL is the Auth0 tenant URL, e.g. https://your-tenant.us.auth0.com
ISSUER_BASE_URL=
# The API identifier (audience) configured for the Auth0 API.
AUTH_AUDIENCE=
# Auth0 access tokens do not carry email by default; add it via an Auth0 Action
# as a namespaced custom claim and set its name here, e.g. https://hss.gov.yk.ca/email
AUTH_EMAIL_CLAIM=
# Optional: override the JWKS endpoint (defaults to ISSUER_BASE_URL/.well-known/jwks.json)
AUTH_JWKS_URI=
SCHEMA_CONSTELLATION=CONSTELLATION_HEALTH
SCHEMA_MIDWIFERY=MIDWIFERY
SCHEMA_HIPMA=HIPMA
SCHEMA_GENERAL=GENERAL
SCHEMA_DENTAL=DENTAL

# --- Database: matches src/db/oracle/docker-compose.yml (Oracle XE, PDB XEPDB1) ---
# SYSTEM/Oracle123 works out of the box because the app issues schema-qualified
# queries across ALL module schemas (only a privileged user can read them all);
# use a least-privilege app user in real environments. The schema owners
# (CONSTELLATION_HEALTH / HIPMA / GENERAL / MIDWIFERY / DENTAL) are created with
# the password HSS_BACKEND by scripts/1_create_schemas.sql.
DB_HOST=localhost
DB_USER=SYSTEM
DB_PASS=Oracle123
DB_SERVICE=XEPDB1
DB_NAME=XEPDB1
DB_PORT=1521

# Redis is no longer required (auth is stateless JWT; sessions were removed).
# Kept for reference / optional use only.
REDIS_HOST=127.0.0.1
REDIS_PASS=pass
REDIS_PORT=6379
REDIS_SECRET=Along,randomly-generatedstringstoredienv

DB_HOST_EDMS=127.0.0.1
DB_USER_EDMS=root
DB_PASS_EDMS=root
DB_NAME_EDMS=DATABASE
DB_NAME_CONSTELLATION_EDMS=
DB_PORT_EDMS=1521

DENTAL_IDS=
CONSTELLATION_IDS=